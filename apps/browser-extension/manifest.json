{
  "manifest_version": 3,
  "name": "Doca Browser Assistant",
  "version": "0.2.4",
  "minimum_chrome_version": "116",
  "description": "Capture pages and selected content with images from a floating toolbar, and use your Doca AI assistant.",
  "permissions": ["storage", "activeTab", "sidePanel", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Doca",
    "default_popup": "ui.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "ui.html#assistant"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["login-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["capture.js", "select.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  },
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Save current page to Doca"
    },
    "capture-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Save selected content to Doca"
    }
  }
}
