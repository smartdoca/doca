// Real production UI and disposable data; no user documents or deployment.
import assert from "node:assert/strict";
import { randomBytes } from "node:crypto";
import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";
import sharp from "sharp";
import { chromium } from "playwright-core";
import { openTestDatabase } from "../tests/database.js";
import { createUser } from "../packages/core/src/modules/identity/passwords.js";
import { createContent } from "../packages/core/src/workflows/resources.js";
const output = resolve("artifacts/verification/site-logo-browser");
await mkdir(output, { recursive: true });
const temporary = await mkdtemp(join(tmpdir(), "doca-site-logo-"));
process.env.DOCA_CREDENTIAL_MASTER_KEY = randomBytes(32).toString("hex");
process.env.DOCA_FILE_STORE_ID = "local";
process.env.DOCA_FILE_STORES_JSON = JSON.stringify({ version: 1, stores: { local: { provider: "local", root: temporary } } });
const { createApp } = await import("../apps/server/src/app/create-app.js");
const { storageRuntime } = await import("../apps/server/src/adapters/storage.js");
const origin = "http://127.0.0.1:39829", password = "isolated-site-logo-2026";
const db = await openTestDatabase({ driver: "sqlite", path: ":memory:" });
const owner = { ...await createUser(db, { login: "logoqa", displayName: "Logo QA", password }, { bootstrap: true }), admin: 1 };
const fixtureDocument = await createContent(db).create(owner, { kind: "document", format: "markdown", title: "Logo fixture document", markdown: "# Synthetic content\nBranding must not replace document icons." });
const app = await createApp(db, { origin, staticDirectory: resolve("apps/web/dist"), storage: storageRuntime(), ai: { memory: { driver: "sqlite", url: ":memory:" } } });
await app.listen({ host: "127.0.0.1", port: 39829 });
const browser = await chromium.launch({ channel: "chrome", headless: true });
const context = await browser.newContext({ viewport: { width: 1440, height: 1000 } });
await context.addInitScript("window.__name = value => value");
const page = await context.newPage(), errors: string[] = [], checks: string[] = [];
page.setDefaultTimeout(15000);
page.on("pageerror", error => errors.push(error.message));
page.on("response", response => { if (response.url().endsWith("/api/v1/admin/site-logo")) console.log("logo-response " + response.status()); });
const shot = (name: string) => page.screenshot({ path: join(output, name + ".png"), animations: "disabled" });
const read = () => db.selectFrom("settings").select(["site_logo", "revision"]).where("id", "=", "system").executeTakeFirstOrThrow();
const adminUrl = origin + "/#/admin?tab=platform&platform=general";
try {
  const png = join(output, "fixture-logo.png"), second = join(output, "fixture-second.webp");
  await sharp(Buffer.from('<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128"><rect width="128" height="128" rx="24" fill="#167a65"/><path d="M38 28h24c48 0 48 72 0 72H38z" fill="none" stroke="white" stroke-width="12"/></svg>')).png().toFile(png);
  await sharp({ create: { width: 96, height: 96, channels: 4, background: "#b54a52" } }).webp().toFile(second);
  const login = await context.request.post(origin + "/api/v1/auth/login", { headers: { origin }, data: { login: "logoqa", password } });
  assert.equal(login.status(), 200, await login.text());
  await page.goto(adminUrl);
  const card = page.getByRole("region", { name: "系统 Logo", exact: true });
  await card.waitFor();
  assert.equal(await card.locator(".site-logo img").count(), 0);
  await shot("admin-default");
  const nameField = page.getByRole("textbox", { name: "站点名称", exact: true });
  await nameField.fill("Unsaved site-name draft");
  await card.getByLabel("选择图片", { exact: true }).setInputFiles(png);
  await card.locator('.site-logo img[src^="blob:"]').waitFor();
  await card.getByRole("button", { name: "保存设置", exact: true }).click();
  await page.getByText("Logo 已保存", { exact: true }).waitFor();
  assert.equal(await nameField.inputValue(), "Unsaved site-name draft", "saving logo preserves unsaved site text");
  await page.waitForFunction(() => document.querySelector<HTMLLinkElement>('link[rel="icon"]')?.href.includes("/api/v1/site-logo?v="));
  const original = await read(); assert(original.site_logo);
  await shot("admin-saved"); checks.push("upload-preview-save-and-unsaved-fields");
  await page.goto(origin + "/#/home");
  await page.locator('.sidebar .brand img[src^="/api/v1/site-logo"]').waitFor();
  await shot("workspace-logo");
  await page.reload();
  await page.locator('.sidebar .brand img[src^="/api/v1/site-logo"]').waitFor();
  checks.push("workspace-and-reload");
  const visitor = await browser.newContext({ viewport: { width: 1280, height: 900 } });
  const signIn = await visitor.newPage();
  await signIn.goto(origin);
  await signIn.locator('.auth-site-brand img[src^="/api/v1/site-logo"]').waitFor();
  await signIn.screenshot({ path: join(output, "login-logo.png"), animations: "disabled" });
  await visitor.close(); checks.push("anonymous-sign-in-logo");
  await page.goto(origin + "/#/r/" + fixtureDocument.id);
  await page.waitForFunction(() => {
    const href = document.querySelector<HTMLLinkElement>('link[rel="icon"]')?.href;
    return !!href && !href.includes("/site-logo") && !href.endsWith("/favicon.svg");
  });
  checks.push("document-icon-preserved");
  await page.goto(adminUrl); await card.waitFor();
  await card.getByLabel("选择图片", { exact: true }).setInputFiles(second);
  await page.route("**/api/v1/admin/site-logo", route => route.fulfill({ status: 503, contentType: "application/json", body: JSON.stringify({ message: "Synthetic upload failure" }) }));
  await card.getByRole("button", { name: "保存设置", exact: true }).click();
  await page.getByText("Synthetic upload failure", { exact: true }).waitFor();
  assert.equal(await card.locator('.site-logo img[src^="blob:"]').count(), 1);
  assert(await card.getByRole("button", { name: "保存设置", exact: true }).isEnabled());
  assert.deepEqual(await read(), original);
  await shot("upload-failure-retains-preview");
  await page.unroute("**/api/v1/admin/site-logo");
  await card.getByRole("button", { name: "保存设置", exact: true }).click();
  await page.getByText("Logo 已保存", { exact: true }).waitFor();
  assert.notEqual((await read()).site_logo, original.site_logo);
  checks.push("failed-save-retains-file-and-retries");
  await page.setViewportSize({ width: 390, height: 1000 });
  await card.scrollIntoViewIfNeeded();
  await shot("admin-390");
  assert(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth), "narrow layout must not overflow");
  await card.getByRole("button", { name: "恢复默认图标", exact: true }).click();
  await page.waitForFunction(() => document.querySelector<HTMLLinkElement>('link[rel="icon"]')?.href.endsWith("/favicon.svg"));
  assert.equal((await read()).site_logo, null);
  await page.reload(); await card.waitFor();
  assert.equal(await card.locator(".site-logo img").count(), 0);
  await shot("reset-and-reload"); checks.push("reset-default-and-reload");
  assert.deepEqual(errors, []);
  await writeFile(join(output, "result.json"), JSON.stringify({ passed: true, productionBuild: true, checks, errors }, null, 2));
  console.log(JSON.stringify({ passed: true, checks }));
} catch (error) {
  await shot("failure");
  await writeFile(join(output, "failure.html"), await page.content());
  console.log(JSON.stringify({ alerts: await page.locator('[role="alert"]').allTextContents(), errors }));
  throw error;
} finally {
  await browser.close(); await app.close(); await db.destroy(); await rm(temporary, { recursive: true, force: true });
}
