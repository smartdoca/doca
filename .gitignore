# Local browser-test output, scratch work and logs; keep reusable tests.
/artifacts/knowledge-book-network-demo/
test-results/
playwright-report/
blob-report/
/tmp/
/.local/
/docs/local/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local pack output is disposable; vendor contains required file: dependencies.
*.tgz
*.zip
!/vendor/*.tgz

# Local agent rule. The same rule lives in the user Cursor rules directory.
.cursor/rules/no-forward-compatibility.mdc

