# The application creates the current schema in a new empty database.
DOCA_ORIGIN=http://127.0.0.1:39130
DOCA_HOST=127.0.0.1
DOCA_PORT=39120
DOCA_WEB_PORT=39130
DOCA_DATABASE=sqlite
DOCA_SQLITE_PATH=./data/v1/doca.db
# DOCA_DATABASE=postgres
# DOCA_DATABASE_URL=postgresql://user:password@localhost:5432/doca_v1
# Maximum connections opened by this process. Budget instance count × this value
# below the PostgreSQL server/proxy connection limit.
# DOCA_DATABASE_POOL_MAX=10
# Optional distributed coordination. Leave unset for the zero-configuration
# single-instance event bus, presence registry and rate limiter.
# DOCA_REDIS_URL=redis://127.0.0.1:6379
# DOCA_REDIS_PREFIX=doca
# DOCA_INSTANCE_ID=doca-1

# Comma-separated trusted reverse-proxy IPs/CIDRs. Leave empty when connecting
# directly; never trust arbitrary forwarding headers.
DOCA_TRUST_PROXY=
# Unified asset storage. Keep this directory persistent and outside the public web root.
DOCA_UPLOAD_DIR=./data/v1/uploads
# Service credentials are configured in Admin > Platform settings > Service credentials.
# SSO, verification gateway, S3, CDN and search credentials are persisted in the database.

# Independent plugin installation directory (read at startup).
# Empty/unset: ${DOCA_DATA_DIR:-./data}/plugins; relative paths use the working directory.
DOCA_PLUGINS_DIR=

# Root directory for plugin business data. Each plugin uses <root>/<plugin-id>/.
# Empty/unset: ${DOCA_DATA_DIR:-./data}/plugin-data. Relative paths use the working directory.
DOCA_PLUGINS_DATA_DIR=

# Official plugin store HTTPS origin (restart after changing).
DOCA_PLUGIN_STORE_URL=https://store.smartdoca.cc

# Registry for complete prebuilt plugin packages (public registries only).
DOCA_PLUGIN_NPM_REGISTRY=https://registry.npmjs.org
