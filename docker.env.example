# Compose automatically reads .env from the project directory.
# Copy this file to .env and replace the origin and example key before starting.
DOCA_ORIGIN=https://docs.example.com
# HTTP origins are supported for trusted internal deployments, e.g. http://doca.internal.
# Browser/QR/WebView and mobile bearer login lifetimes, in seconds.
# Positive integer up to 2147483647; restart to apply to new logins/mobile renewals.
DOCA_SESSION_TTL_SECONDS=86400
DOCA_MOBILE_SESSION_TTL_SECONDS=15552000

# Required for every startup, even without plugins.
# Public example only: replace it with your own output from openssl rand -hex 32.
# Generate once: 32 random bytes encoded as 64 hexadecimal characters.
# Every replica must receive the same value. Retain and back it up separately.
# Existing deployments must keep their original key; do not regenerate on restart.
DOCA_CREDENTIAL_MASTER_KEY=7a52d29ab6db9a08292b9585d0dc5551f4156c2d02953b4262611bc1ad82f9ab

# Deployment-owned database and coordination backend. Defaults are SQLite and
# process-local coordination. Compose passes these choices to the container.
# DOCA_DATABASE=postgres
# DOCA_DATABASE_URL=postgresql://user:password@postgres:5432/doca
# DOCA_WEBHOOK_DATABASE_URL=postgresql://user:password@postgres:5432/doca_webhooks
# DOCA_REDIS_URL=redis://redis:6379
# DOCA_REDIS_PREFIX=doca
# DOCA_INSTANCE_ID=doca-1
# DOCA_DATABASE_POOL_MAX=10
# Submitted paid image requests per source page; positive safe decimal integer.
# Restart to apply. Zero/empty/invalid values fail startup; counts never reset.
DOCA_AI_IMAGE_MAX_ATTEMPTS_PER_PAGE=5

# Optional local segmentation requires a mounted trusted runtime/profile.
# See docs/ai-image-segmentation.md; no Python/weights are bundled by default.
# DOCA_AI_IMAGE_SEGMENT_PROFILE=/opt/segment/profile.json
# No proxy is trusted by default. Use only the actual proxy IP/CIDR seen by Doca.
# Example only; verify the Docker bridge gateway before using it:
# DOCA_TRUST_PROXY=172.17.0.1/32

# Optional plugin installation directory inside the container.
# Keep it writable and persistent per instance when overriding this setting.
# Empty/unset: ${DOCA_DATA_DIR:-./data}/plugins.
DOCA_PLUGINS_DIR=

# Optional base URL for built JS and CSS. Leave empty to serve /assets from
# this container. When set, index.html still comes from Doca and only the
# asset URLs inside it use this prefix. The prefix must allow CORS for ES
# modules. See docs/development.md.
# DOCA_ASSET_BASE=https://cdn.example.com/doca/0.1.11

DOCA_FILE_STORE_ID=local
# The container runs as node and persists /data. Development paths such as
# ./data/v1/storage resolve under /app and are not writable in the image.
DOCA_FILE_STORES_JSON='{"version":1,"stores":{"local":{"provider":"local","root":"/data/storage"}}}'
# S3 example: replace both active variables above. Use a private bucket and real
# credentials supplied by the deployer. Cloud storage is configured only here.
# DOCA_FILE_STORE_ID=cloud
# DOCA_FILE_STORES_JSON='{"version":1,"stores":{"cloud":{"provider":"s3","bucket":"your-private-bucket","region":"us-east-1","forcePathStyle":false,"credentials":{"accessKeyId":"replace-me","secretAccessKey":"replace-me"}}}}'
# RustFS on a trusted internal network: use its S3 API endpoint (port 9000),
# path-style addressing, and a hostname/IP reachable from the Doca container.
# HTTP(S) endpoints must be root origins without credentials/path/query/fragment.
# Site, asset and CDN origins accept HTTP(S); use HTTP on trusted networks.
# DOCA_FILE_STORE_ID=cloud
# DOCA_FILE_STORES_JSON='{"version":1,"stores":{"cloud":{"provider":"s3","bucket":"doca-files","region":"us-east-1","endpoint":"http://rustfs:9000","forcePathStyle":true,"credentials":{"accessKeyId":"replace-me","secretAccessKey":"replace-me"}}}}'
